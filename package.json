{
  "name": "@lanjing-digital/laps-cli",
  "version": "0.1.15",
  "description": "Cross-platform launcher and skill installer for LAPS CLI",
  "type": "module",
  "bin": {
    "laps-cli": "npm/bin/laps-cli.js",
    "laps-mcp": "npm/bin/laps-mcp.js"
  },
  "files": [
    "npm/bin",
    "npm/lib",
    "npm/mcp",
    "npm/test",
    "docs",
    "scripts",
    "skills",
    "README.md",
    "package.json",
    "VERSION"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanjing-digital/laps-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lanjing-digital/laps-cli/issues"
  },
  "homepage": "https://github.com/lanjing-digital/laps-cli#readme",
  "scripts": {
    "test": "node --test npm/test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "connector:build": "node scripts/build-workbuddy-connector.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  }
}
